; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Everglade"
config/description="A cozy, gridless diorama builder. Draw walls, paths and cottages and watch your glade come alive."
config/version="1.0.0"
run/main_scene="res://scenes/game.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.85, 0.92, 0.96, 1)
boot_splash/show_image=true
boot_splash/image="res://assets/icons/splash.png"
boot_splash/fullsize=false
config/icon="res://assets/icons/icon_512.png"
run/low_processor_mode=false

[autoload]

Settings="*res://scripts/core/settings.gd"
ModelLib="*res://scripts/core/model_lib.gd"
Sfx="*res://scripts/core/audio.gd"
GladeStore="*res://scripts/core/glade_store.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[gui]

common/drop_mouse_on_gui_input_disabled=true
theme/default_font_antialiasing=1

[input_devices]

pointing/emulate_touch_from_mouse=true
pointing/emulate_mouse_from_touch=true

[physics]

common/physics_ticks_per_second=30
3d/run_on_separate_thread=false

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
environment/defaults/default_clear_color=Color(0.78, 0.88, 0.95, 1)

[shader_globals]

night={
"type": "float",
"value": 0.0
}
wind_strength={
"type": "float",
"value": 1.0
}
season_leaf={
"type": "color",
"value": Color(1, 1, 1, 1)
}
season_ground={
"type": "color",
"value": Color(1, 1, 1, 1)
}
snow_amount={
"type": "float",
"value": 0.0
}
