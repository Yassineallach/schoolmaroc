class_name DeckArt
extends RefCounted

## Aleatro's pixel deck. Every face is painted into a 70x98 image and cached
## as a texture (pre-scaled 2x so it stays crisp when drawn onto the card):
## - corner index: a 5x7 rank over a 7x7 suit, repeated upside down in the
##   opposite corner
## - 2-10: traditional pip layouts, pips past the middle turned upside down
## - ace: one large pip with a shaded rim
## - J / Q / K: double-ended court figures inside a thin frame, generated by
##   tools/make_courts.py (see CourtArt), recoloured per suit
## The face itself (paper colour, enhancement tint) is drawn by CardView
## underneath, so these images are transparent apart from the ink.

const W := 70
const H := 98

# ---------------------------------------------------------------- glyphs

## 5x7 rank glyphs ("1" is 3 wide, for 10).
const GLYPHS := {
	"A": [".###.", "#...#", "#...#", "#####", "#...#", "#...#", "#...#"],
	"2": [".###.", "#...#", "....#", "...#.", "..#..", ".#...", "#####"],
	"3": ["####.", "....#", "....#", ".###.", "....#", "....#", "####."],
	"4": ["...#.", "..##.", ".#.#.", "#..#.", "#####", "...#.", "...#."],
	"5": ["#####", "#....", "####.", "....#", "....#", "#...#", ".###."],
	"6": [".###.", "#....", "#....", "####.", "#...#", "#...#", ".###."],
	"7": ["#####", "....#", "...#.", "..#..", ".#...", ".#...", ".#..."],
	"8": [".###.", "#...#", "#...#", ".###.", "#...#", "#...#", ".###."],
	"9": [".###.", "#...#", "#...#", ".####", "....#", "....#", ".###."],
	"1": [".#.", "##.", ".#.", ".#.", ".#.", ".#.", "###"],
	"0": [".###.", "#...#", "#..##", "#.#.#", "##..#", "#...#", ".###."],
	"J": ["..###", "...#.", "...#.", "...#.", "#..#.", "#..#.", ".##.."],
	"Q": [".###.", "#...#", "#...#", "#...#", "#.#.#", "#..#.", ".##.#"],
	"K": ["#...#", "#..#.", "#.#..", "##...", "#.#..", "#..#.", "#...#"],
}

## 7x7 corner suits: spade, heart, club, diamond.
const SMALL := [
	["...#...", "..###..", ".#####.", "#######", "#######", "...#...", "..###.."],
	[".##.##.", "#######", "#######", "#######", ".#####.", "..###..", "...#..."],
	["..###..", ".#####.", "..###..", "##.#.##", "#######", "##.#.##", "..###.."],
	["...#...", "..###..", ".#####.", "#######", ".#####.", "..###..", "...#..."],
]

## 9x9 pips: spade, heart, club, diamond.
const PIPS := [
	["....#....", "...###...", "..#####..", ".#######.", "#########", "#########", ".##.#.##.", "....#....", "...###..."],
	[".........", ".##...##.", "####.####", "#########", "#########", ".#######.", "..#####..", "...###...", "....#...."],
	["...###...", "..#####..", "...###...", ".##.#.##.", "#########", "#########", ".##.#.##.", "....#....", "...###..."],
	["....#....", "...###...", "..#####..", ".#######.", "#########", ".#######.", "..#####..", "...###...", "....#...."],
]

## Pip centres (x, y) per rank; pips below the middle are drawn upside down.
const L := 22
const C := 35
const R := 48
const LAYOUTS := {
	2: [[C, 20], [C, 78]],
	3: [[C, 20], [C, 49], [C, 78]],
	4: [[L, 20], [R, 20], [L, 78], [R, 78]],
	5: [[L, 20], [R, 20], [C, 49], [L, 78], [R, 78]],
	6: [[L, 20], [R, 20], [L, 49], [R, 49], [L, 78], [R, 78]],
	7: [[L, 20], [R, 20], [C, 34], [L, 49], [R, 49], [L, 78], [R, 78]],
	8: [[L, 20], [R, 20], [C, 34], [L, 49], [R, 49], [C, 64], [L, 78], [R, 78]],
	9: [[L, 20], [R, 20], [L, 39], [R, 39], [C, 49], [L, 59], [R, 59], [L, 78], [R, 78]],
	10: [[L, 20], [R, 20], [C, 30], [L, 39], [R, 39], [L, 59], [R, 59], [C, 68], [L, 78], [R, 78]],
}

## Court palettes per suit: dark (also the ink), main, gold, light accent.
const COURT_COLORS := [
	{"D": Color("343a60"), "M": Color("f25c54"), "G": Color("f7a01e"), "B": Color("42aaf0")},
	{"D": Color("37424d"), "M": Color("ea3a64"), "G": Color("f7a01e"), "B": Color("42aaf0")},
	{"D": Color("1f403a"), "M": Color("1d6fd1"), "G": Color("f7a01e"), "B": Color("f25c54")},
	{"D": Color("3c3446"), "M": Color("f06e32"), "G": Color("fac83c"), "B": Color("42aaf0")},
]
const COURT_X := 11  # left column of the court half (it is 47 wide, centred)

static var _cache := {}


## The face texture for `rank` (2-14) of `suit` (0 spade, 1 heart, 2 club, 3 diamond).
## The 70x98 art is enlarged 2x with nearest sampling, so CardView can draw it
## with linear filtering at any size and the pixels stay sharp and even.
static func face(rank: int, suit: int) -> ImageTexture:
	var key := rank * 4 + suit
	if not _cache.has(key):
		var img := paint(rank, suit)
		img.resize(W * 2, H * 2, Image.INTERPOLATE_NEAREST)
		_cache[key] = ImageTexture.create_from_image(img)
	return _cache[key]


## The face at its native 70x98, for tools and previews.
static func paint(rank: int, suit: int) -> Image:
	var img := Image.create(W, H, false, Image.FORMAT_RGBA8)
	img.fill(Color(0, 0, 0, 0))
	var col: Color = Data.SUIT_COLORS[suit]
	if rank >= 11 and rank <= 13:
		_court(img, rank, suit)
	_index(img, rank, suit, col)
	if rank == 14:
		_big_pip(img, suit, col)
	elif rank <= 10:
		for p in LAYOUTS[rank]:
			_bitmap(img, PIPS[suit], p[0] - 4, p[1] - 4, col, p[1] > 49)
	return img


# ---------------------------------------------------------------- pieces

static func _bitmap(img: Image, rows: Array, x0: int, y0: int, col: Color, flip := false) -> void:
	var h := rows.size()
	for y in h:
		var row: String = rows[h - 1 - y] if flip else rows[y]
		for x in row.length():
			if row[x] == "#":
				img.set_pixel(x0 + x, y0 + y, col)


static func _index(img: Image, rank: int, suit: int, col: Color) -> void:
	var label: String = Data.RANK_LABELS[rank]
	var x := 3
	for ch in label:
		_bitmap(img, GLYPHS[ch], x, 4, col)
		x += GLYPHS[ch][0].length() + 1
	var width := x - 4
	_bitmap(img, SMALL[suit], 3 + (width - 7) / 2 if width > 7 else 2, 13, col)
	# the same index, upside down in the opposite corner
	for y in 21:
		for xx in 12:
			var c := img.get_pixel(xx, y)
			if c.a > 0.0:
				img.set_pixel(W - 1 - xx, H - 1 - y, c)


## A large pip, rasterised from the suit's shape, with a darker rim on its
## lower edge.
static func _big_pip(img: Image, suit: int, col: Color) -> void:
	const S := 27
	var x0 := C - S / 2
	var y0 := 49 - S / 2
	for y in S:
		for x in S:
			var p := Vector2((x + 0.5) / S - 0.5, (y + 0.5) / S - 0.5)
			if _in_suit(suit, p):
				var below := Vector2(p.x, p.y + 1.5 / S)
				img.set_pixel(x0 + x, y0 + y, col if _in_suit(suit, below) else col.darkened(0.35))


## Whether point `p` (unit square, centred) lies inside the suit shape.
static func _in_suit(suit: int, p: Vector2) -> bool:
	match suit:
		1:
			return p.distance_to(Vector2(-0.24, -0.14)) < 0.26 or p.distance_to(Vector2(0.24, -0.14)) < 0.26 \
				or _in_tri(p, Vector2(-0.49, -0.04), Vector2(0.49, -0.04), Vector2(0, 0.5))
		3:
			return absf(p.x) / 0.4 + absf(p.y) / 0.5 <= 1.0
		0:
			return p.distance_to(Vector2(-0.23, 0.1)) < 0.25 or p.distance_to(Vector2(0.23, 0.1)) < 0.25 \
				or _in_tri(p, Vector2(-0.48, 0.06), Vector2(0, -0.5), Vector2(0.48, 0.06)) \
				or _in_tri(p, Vector2(0, 0.1), Vector2(0.17, 0.5), Vector2(-0.17, 0.5))
		_:
			return p.distance_to(Vector2(0, -0.24)) < 0.22 or p.distance_to(Vector2(-0.24, 0.08)) < 0.22 \
				or p.distance_to(Vector2(0.24, 0.08)) < 0.22 \
				or _in_tri(p, Vector2(0, -0.05), Vector2(0.17, 0.5), Vector2(-0.17, 0.5))


static func _in_tri(p: Vector2, a: Vector2, b: Vector2, c: Vector2) -> bool:
	var d1 := (p - b).cross(a - b)
	var d2 := (p - c).cross(b - c)
	var d3 := (p - a).cross(c - a)
	return not ((d1 < 0 or d2 < 0 or d3 < 0) and (d1 > 0 or d2 > 0 or d3 > 0))


# ---------------------------------------------------------------- courts

## A court card: a thin frame, then the half figure in the top half and the
## same half turned upside down below, like a real double-ended card.
static func _court(img: Image, rank: int, suit: int) -> void:
	var pal := _palette(suit)
	var ink: Color = pal["K"]
	for x in range(14, W - 14):
		img.set_pixel(x, 6, ink)
		img.set_pixel(x, H - 7, ink)
	for y in range(6, H - 6):
		img.set_pixel(14, y, ink)
		img.set_pixel(W - 15, y, ink)
	var rows: Array = CourtArt.HALVES["%s%d" % ["JQK"[rank - 11], suit]]
	for y in rows.size():
		var row: String = rows[y]
		for x in row.length():
			var ch := row[x]
			if ch == ".":
				continue
			var c: Color = pal[ch]
			img.set_pixel(COURT_X + x, y, c)
			img.set_pixel(W - 1 - (COURT_X + x), H - 1 - y, c)


static func _palette(suit: int) -> Dictionary:
	var base: Dictionary = COURT_COLORS[suit]
	return {
		"K": base.D, "D": base.D, "M": base.M, "m": base.M.darkened(0.3),
		"G": base.G, "g": base.G.darkened(0.3), "B": base.B, "b": base.B.darkened(0.3),
		"W": Color.WHITE, "F": Color("e2e2e2"), "f": Color("a8aaaf"),
	}
