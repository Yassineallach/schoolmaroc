yplvega&type=unbound&nicaption=Proyecto+hail+Mary%1FWeir%2C+Andy.%1FeAudiobook","large":"https://secure.syndetics.com/index.aspx?isbn=9788418037122/lc.gif&client=nyplvega&type=unbound&nicaption=Proyecto+hail+Mary%1FWeir%2C+Andy.%1FeAudiobook"}},{"id":"4e05cfdd-2222-11ee-89ac-0121bd2de982","availabilityStatus":"Available","callNumber":"eNYPL AUDIO","hasItems":false,"recordId":"23073125","publicationDate":"2021","type":"electronic","subscriptionId":["ad1d9a74-9c4f-4dab-a2d7-de803e523f61"],"vendors":{"cloudlibrary":{"reserveId":["ae8dbvz9"]}},"isGetItSuppressed":false,"issuance":["monograph"],"coverUrl":{"small":"https://secure.syndetics.com/index.aspx?isbn=9788418037122/sc.gif&client=nyplvega&type=unbound&nicaption=Proyecto+hail+Mary%1FWeir%2C+Andy.%1FeAudiobook","medium":"https://secure.syndetics.com/index.aspx?isbn=9788418037122/mc.gif&client=nyplvega&type=unbound&nicaption=Proyecto+hail+Mary%1FWeir%2C+Andy.%1FeAudiobook","large":"https://secure.syndetics.com/index.aspx?isbn=9788418037122/lc.gif&client=nyplvega&type=unbound&nicaption=Proyecto+hail+Mary%1FWeir%2C+Andy.%1FeAudiobook"}}],"checkAvailabilityFromOtherSources":true,"identifiedBy":{"local":["1252781089","1301383687"],"isbn":["9788418037122","8418037121","9788418037122","8418037121"]},"translationKey":"format-group.E_AUDIO_BOOK","issuance":["monograph"],"coverUrl":{"small":"https://secure.syndetics.com/index.aspx?isbn=9788418037122/sc.gif&client=nyplvega&type=unbound&nicaption=Proyecto+hail+Mary%1FWeir%2C+Andy.%1FeAudiobook","medium":"https://secure.syndetics.com/index.aspx?isbn=9788418037122/mc.gif&client=nyplvega&type=unbound&nicaption=Proyecto+hail+Mary%1FWeir%2C+Andy.%1FeAudiobook","large":"https://secure.syndetics.com/index.aspx?isbn=9788418037122/lc.gif&client=nyplvega&type=unbound&nicaption=Proyecto+hail+Mary%1FWeir%2C+Andy.%1FeAudiobook"},"description":"The new novel by the author of The Martian, which will become a film starring and produced by Ryan Gosling. A SINGLE ASTRONAUT. AN IMPOSSIBLE MISSION. AN ALLY WHO WOULD NEVER HAVE IMAGINED. Ryland Grace is the only survivor on a desperate mission. It is the last chance and if it fails, humanity and the Earth itself will perish. Of course, at the moment, he he does not know. He can't even remember his own name, much less the nature of his mission or how to carry it out. The only thing he knows is that he has been in an induced coma for a long, long time. He has just awakened and is millions of miles from his home, with no other company than two corpses. The crewmates are dead, and as he confusedly recovers his memories of him, Grace realizes that he faces an impossible mission. Traveling through space in a small ship, it is up to him to end an extinction threat to our species. With little time and with the closest human being light years away, he will have to achieve it being completely alone. Or not? Project Hail Mary, an irresistible interstellar adventure as only Andy Weir could imagine, is a story of discovery, speculation and survival at the height of The Martian, which takes us to places we never dreamed of reaching. Reviews: I loved The Martian, but Project Hail Mary seems like Andy Weir's best work to date. This is the only book I read last year that I can recommend without hesitation to anyone, whoever they are, because I know they will love it. Brandon Sanderson A novel that would have delighted Robert A. Heinlein and Isaac Asimov ... . Two worlds in danger, a competent (but human and flawed) man, and endless riddles to be solved with humanity in danger. The book has everything that fans of classic science fiction (like me) love. George R.R. Martin Reading Project Hail Mary is like going on an excursion into space with the best science teacher you've ever had, and your class work is to save the world. It is one of the most original, exciting and fun trips I have ever done. Ernest Cline Brilliant, funny and enjoyable ... . One of the most credible science fiction books I have ever read. Tim Peake, astronaut at the European Space Agency","identifiers":{"local":"1252781089","isbn":"9788418037122"}}],"identifiers":{"isbn":"9788410466241","local":"1615426943"},"language":"spa"},{"id":"3be386f6-e916-5ba8-afdc-c38f4d97ad54","customerId":"5adfabe6-eb6b-4aa9-b1ba-316f6d7f1533","entityType":"FormatGroup","coverUrl":{"small":"https://secure.syndetics.com/index.aspx?isbn=9788925588735/sc.gif&client=nyplvega&type=unbound&nicaption=%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8+%ED%97%A4%EC%9D%BC+%EB%A9%94%EB%A6%AC+%3D+Project+Hail+Mary+%7C+P%27%C5%ADrojekt%27%C5%AD+Heil+Meri+%3D+Project+Hail+Mary%1FWeir%2C+Andy%1FBook","medium":"https://secure.syndetics.com/index.aspx?isbn=9788925588735/mc.gif&client=nyplvega&type=unbound&nicaption=%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8+%ED%97%A4%EC%9D%BC+%EB%A9%94%EB%A6%AC+%3D+Project+Hail+Mary+%7C+P%27%C5%ADrojekt%27%C5%AD+Heil+Meri+%3D+Project+Hail+Mary%1FWeir%2C+Andy%1FBook","large":"https://secure.syndetics.com/index.aspx?isbn=9788925588735/lc.gif&client=nyplvega&type=unbound&nicaption=%ED%94%84%EB%A1%9C%EC%A0%9D%ED%8A%B8+%ED%97%A4%EC%9D%BC+%EB%A9%94%EB%A6%AC+%3D+Project+Hail+Mary+%7C+P%27%C5%ADrojekt%27%C5%AD+Heil+Meri+%3D+Project+Hail+Mary%1FWeir%2C+Andy%1FBook"},"title":"프로젝트 헤일 메리 = Project Hail Mary | P'ŭrojekt'ŭ Heil Meri = Project Hail Mary","publicationDate":"2021","primaryAgent":{"id":"1570ff03-3b72-11ec-9bf8-f19e7791a660","label":"Weir, Andy"},"materialTabs":[{"name":"Book","type":"physical","callNumber":"KOR FIC WEIR","itemLocation":"53rd Street World Languages","itemLibrary":"53rd Street","itemLocationCode":"fta0l","itemLibraryCode":"ft","availability":{"isGetItSuppressed":false,"status":{"general":"Available"},"nonCirculating":false},"recordIds":["23917740"],"materialTypes":["a"],"locations":[{"code":"ft","label":"53rd Street","availabilityStatus":"Available"},{"code":"sn","label":"Stavros Niarchos Foundation Library (SNFL)","availabilityStatus":"Unavailable"}],"hasMoreLocations":true,"locationsTotalResults":2,"editions":[{"id":"cfe41e3a