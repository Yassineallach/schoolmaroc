<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: also trust user-installed CAs, so traffic can be inspected
  with a local proxy (or routed through one on a test emulator). Release builds
  have no network security config and trust system CAs only.
-->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
